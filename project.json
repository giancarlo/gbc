{
	"core": {
		"filesExclude": ["./docs/"]
	},
	"watch": {
		"rules": {
			"build": {
				"regex": "/([^/]+)/.+",
				"tasks": "npm run build --prefix $1"
			}
		}
	},
	"coaxial": {
		"worktree": {
			"setup": "ln -s ../../node_modules node_modules"
		}
	},
	"ai": {
		"instructions": ["To run tests: npm test --prefix gbc/dirName"]
	}
}
