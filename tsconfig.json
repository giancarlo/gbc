{
	"compilerOptions": {
		"incremental": true,
		"strict": true,
		"target": "esnext",
		"module": "NodeNext",
		"lib": ["ESNext"],
		"experimentalDecorators": true,
		"sourceMap": false,
		"moduleResolution": "NodeNext",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"composite": true,
		"skipLibCheck": true,
		"typeRoots": []
	},
	"files": []
}
