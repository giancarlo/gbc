{
	"compilerOptions": {
		"incremental": true,
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"noUncheckedSideEffectImports": true,
		"composite": true,
		"types": []
	}
}